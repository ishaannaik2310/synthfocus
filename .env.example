# SynthFocus Root Environment Configuration Template

# Google Gemini API Key (Required for backend LLM calls)
GOOGLE_API_KEY=your_gemini_api_key_here

# Model Selection (Default: current Flash model)
GEMINI_MODEL=gemini-2.5-flash

# Throttled Map-Reduce Engine Settings (Gemini Free Tier: 15 RPM / 1,500 RPD)
BATCH_SIZE=2
BATCH_SLEEP_SECONDS=13

# Frontend API URL (for client-side SSE connections)
NEXT_PUBLIC_API_URL=http://localhost:8000
