# Google Gemini API Key
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini Model Name (Default to current Flash model)
GEMINI_MODEL=gemini-2.5-flash

# Throttled Map-Reduce Configuration (Tuned for Gemini Free Tier: 15 RPM / 1500 RPD)
# 5 micro-batches of 2 personas = 10 calls + 1 analyst call = 11 calls.
# 4 sleeps of 13s = 52s delay + API roundtrip latency (~20s) = ~72s execution time.
# 11 calls in 72s = ~9.1 RPM (well under 15 RPM, reserving safety buffer for retries).
BATCH_SIZE=2
BATCH_SLEEP_SECONDS=13

# Prompt Injection & Input Guards
MAX_BRIEF_LENGTH=5000
MIN_BRIEF_LENGTH=10

# Per-IP Rate Limiting (Simulations allowed per hour)
RATE_LIMIT_SIMULATIONS_PER_HOUR=10

# Trusted reverse proxy hops for client IP extraction (1 for AWS ALB, 2 if CloudFront is in front of ALB)
TRUSTED_PROXY_HOPS=1

# Allowed CORS Origins (comma-separated origins; defaults to localhost for dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
